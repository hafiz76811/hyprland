{
  "custom/battery": {
  	"exec": "~/.config/waybar/scripts/battery.sh",
  	"interval": 2,
  	"tooltip": true,
  	"return-type": "json",

  	"format": "{icon} {text}%",
  	"format-full": " {text}%",
  	"format-warning": "󰂎 {text}%",
  	"format-critical": "󰂃 {text}%",
  	"format-alt": "Batt: {text}%",
  	"format-icons": ["", "", "", "", ""]
  }
}
