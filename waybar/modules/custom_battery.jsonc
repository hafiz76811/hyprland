{
  "custom/battery": {
  	"exec": "~/.config/waybar/scripts/battery.sh",
  	"interval": 2,
  	"tooltip": true,
  	"return-type": "json",

  	"format": "{icon} {text}%",
  	"format-alt": "Batt: {text}%",
  	"format-icons":
		"full": "",
		"charging": "",
		"warning": "󰂃",
		"critical": "",
		"default": ["", "", "", "", ""]
  }
}
