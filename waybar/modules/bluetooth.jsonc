{
    "bluetooth": {
	"controller": "archlinux", // specify the alias of the controller if there are more than 1 on the system
	"format": "{status}",
	"format-disabled": "󰂲 Disabled", // an empty format will hide the module
	"format-off": "󰂲 Disabled", // an empty format will hide the module
	"format-on": "󰂯 Enabled", // an empty format will hide the module
	"format-connected": "󰂱 {device_alias}",
	"format-connected-battery": "󰂱 {device_alias} {device_battery_percentage}%",
	"tooltip-format": "Turn on/off bluetooth",
	"on-click": "~/.config/waybar/scripts/bluetooth.sh"
    }
}
